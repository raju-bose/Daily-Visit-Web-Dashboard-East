*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial;background:#f3f6fa;color:#172033}
.wrap{max-width:1550px;margin:auto;padding:20px}.head{background:linear-gradient(135deg,#123b63,#1769aa);color:white;padding:24px 28px;border-radius:18px}
