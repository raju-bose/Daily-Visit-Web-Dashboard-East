.grid2{display:grid;grid-template-columns:2fr 1fr;gap:15px;margin-top:15px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:15px}
.card h3{margin:0 0 10px;font-size:15px}.chart{height:290px;position:relative}.table{margin-top:15px;overflow:hidden}.scroll{overflow:auto;max-height:500px}
table{border-collapse:collapse;width:100%;font-size:12px}th{position:sticky;top:0;background:#eaf1f7;padding:10px;text-align:left;white-space:nowrap}td{padding:8px;border-bottom:1px solid #edf0f4;white-space:nowrap}
.badge{padding:4px 8px;border-radius:20px;font-weight:700;font-size:11px}.site{background:#e4f5ee;color:#137653}.trav{background:#fff0d5;color:#9b5a00}
.bar{width:80px;height:7px;background:#edf0f4;border-radius:5px;display:inline-block;vertical-align:middle;margin-right:5px}.bar i{display:block;height:100%;background:#1769aa;border-radius:5px}
@media(max-width:1000px){.kpis{grid-template-columns:repeat(2,1fr)}.grid2,.grid3{grid-template-columns:1fr}}@media(max-width:600px){.wrap{padding:10px}.kpis{grid-template-columns:1fr}h1{font-size:20px}}
</style></head><body><div class="wrap">
