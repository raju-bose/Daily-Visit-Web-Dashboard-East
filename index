function opts(id,key){[...new Set(DATA.map(x=>x[key]).filter(Boolean))].sort().forEach(v=>{let o=document.createElement('option');o.value=v;o.textContent=v;document.getElementById(id).appendChild(o)})}
opts('date','date');opts('status','status');opts('coord','coordinator');opts('type','visitType');
function get(){let q=document.getElementById('q').value.toLowerCase(),d=date.value,s=status.value,c=coord.value,t=type.value;
return DATA.filter(x=>(!q||Object.values(x).join(' ').toLowerCase().includes(q))&&(!d||x.date==d)&&(!s||x.status==s)&&(!c||x.coordinator==c)&&(!t||x.visitType==t))}
function counts(a,k){let o={};a.forEach(x=>o[x[k]]=(o[x[k]]||0)+1);return o}
function avg(a,k){return a.length?a.reduce((s,x)=>s+(+x[k]||0),0)/a.length:0}
function chart(id,type,labels,values){if(charts[id])charts[id].destroy();charts[id]=new Chart(document.getElementById(id),{type,data:{labels,datasets:[{data:values,borderWidth:2,tension:.3,fill:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}}})}function render(){let a=get();vis.textContent=a.length;comp.textContent=Math.round(avg(a,'completion'))+'%';site.textContent=a.filter(x=>x.status=='At Site').length;travel.textContent=a.filter(x=>x.status=='Travelling').length;dpr.textContent=a.filter(x=>x.dpr.includes('✓')).length;count.textContent='('+a.length+' records)';
let cd=counts(a,'date'),ds=Object.keys(cd).sort();chart('trend','line',ds.map(x=>x.slice(8)+'-'+x.slice(5,7)),ds.map(x=>cd[x]));
let cs=counts(a,'status');chart('stat','doughnut',Object.keys(cs),Object.values(cs));
let ct=counts(a,'visitType');chart('types','bar',Object.keys(ct),Object.values(ct));
let cc=counts(a,'coordinator');chart('coords','bar',Object.keys(cc),Object.values(cc));
let cm=ds.map(d=>avg(a.filter(x=>x.date==d),'completion'));chart('completion','line',ds.map(x=>x.slice(8)+'-'+x.slice(5,7)),cm.map(Math.round));
body.innerHTML=a.map(x=>`<tr><td>${x.date}</td><td>${x.sr}</td><td><b>${x.roCode}</b></td><td>${x.roName}</td><td>${x.pendingJob}</td><td>${x.visitType}</td><td>${x.coordinator}</td><td><span class="badge ${x.status=='Travelling'?'trav':'site'}">${x.status}</span></td><td>${x.engineer}</td><td><span class="bar"><i style="width:${Math.min(100,x.completion)}%"></i></span>${x.completion}%</td><td>${x.dpr||'—'}</td><td>${x.remarks||'—'}</td></tr>`).join('')}
function resetAll(){q.value='';date.value='';status.value='';coord.value='';type.value='';render()}
[q,date,status,coord,type].forEach(e=>e.addEventListener('input',render));[date,status,coord,type].forEach(e=>e.addEventListener('change',render));render();
